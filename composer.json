{
  "name": "kasperhartwich/quickdns",
  "description": "QuickDNS library",
  "keywords": ["quickdns", "dns"],
  "license": "MIT",
  "authors": [
    {
      "name": "Kasper Hartwich",
      "email": "kasperhartwich@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "guzzlehttp/guzzle": "^7.0",
    "symfony/dom-crawler": "^7.0|^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5|^11.5.3|^12.0",
    "orchestra/testbench": "^9.17|^10.0|^11.0"
  },
  "suggest": {
    "illuminate/support": "For the Laravel service provider and QuickDns facade (Laravel 11 or later)"
  },
  "autoload": {
    "psr-4": {
      "QuickDns\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "QuickDns\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --testsuite Unit",
    "test:live": "vendor/bin/phpunit --testsuite Live"
  },
  "extra": {
    "laravel": {
      "providers": [
        "QuickDns\\Laravel\\QuickDnsServiceProvider"
      ]
    }
  }
}
